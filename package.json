{
  "name": "ghoststock",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm --filter @ghoststock/contracts build && pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "preinstall": "node -e \"if(!/^pnpm\\//.test(process.env.npm_config_user_agent||'')){console.error('Use pnpm, not npm or yarn.');process.exit(1)}\"",
    "prepare": "node -e \"const {execSync:x}=require('node:child_process');try{x('git rev-parse --git-dir',{stdio:'ignore'})}catch{process.exit(0)}x('git config core.hooksPath .agents/hooks/git')\""
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
